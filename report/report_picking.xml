<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_picking_farmanimals" inherit_id="stock.report_picking">
        <xpath expr="//table[1]/tbody" position="after">
            <t t-set="cantidad_producto" t-value="sum(o.move_ids_without_package.mapped('quantity'))"/>
            <tr>
                <td><strong>TOTAL PRODUCTO</strong></td>
                <td><strong><t t-out="format_number(cantidad_producto)"/></strong></td>
                <td><strong/></td>
            </tr>
        </xpath>
    </template>

    <template id="report_delivery_farmanimals" inherit_id="stock.report_delivery_document">
        <xpath expr="//table[@name='stock_move_table']/thead/tr/th[@name='th_sm_product']" position="before">
            <th name="th_sm_internal_code"><strong>CODIGO INTERNO</strong></th>
            <th name="th_sm_barcode"><strong>CODIGO DE BARRAS</strong></th>
        </xpath>
        <xpath expr="//table[@name='stock_move_table']/thead/tr/th[@name='th_sm_quantity']" position="before">
            <th name="th_sm_lot"><strong>NÚMERO DE SERIE/LOTE</strong></th>
            <th name="th_sm_expiration"><strong>FECHA EXPIRACIÓN</strong></th>
        </xpath>
        <xpath expr="//table[@name='stock_move_table']/tbody/tr/td[1]" position="before">
            <td><span t-field="move.product_id.default_code"/></td>
            <td><span t-field="move.product_id.barcode"/></td>
        </xpath>
        <xpath expr="//table[@name='stock_move_table']/tbody/tr/td[contains(@class, 'o_td_quantity')][last()]" position="before">
            <td>
                <span t-out="', '.join(move.lot_ids.mapped('name'))"/>
            </td>
            <td>
                <span t-out="', '.join([str(date) for date in move.lot_ids.mapped('expiration_date') if date])"/>
            </td>
        </xpath>
        <xpath expr="//table[@name='stock_move_table']/tbody" position="after">
            <t t-set="cantidad_producto" t-value="sum(o.move_ids_without_package.mapped('quantity'))"/>
            <tr>
                <td><strong/></td>
                <td><strong/></td>
                <td><strong/></td>
                <td><strong/></td>
                <td><strong/></td>
                <td><strong>TOTAL PRODUCTO</strong></td>
                <td class="text-end"><strong><t t-out="format_number(cantidad_producto)"/></strong></td>
            </tr>
        </xpath>

        <xpath expr="//th[@name='th_sml_product']" position="before">
            <th name="th_sml_internal_code">CODIGO INTERNO</th>
            <th name="th_sml_barcode">CODIGO DE BARRAS</th>
        </xpath>
        <xpath expr="//th[@name='lot_serial']" position="after">
            <th name="th_sml_expiration" class="text-end">FECHA EXPIRACIÓN</th>
        </xpath>
        <xpath expr="//table[@name='stock_move_line_table']/tbody" position="after">
            <t t-set="cantidad_producto" t-value="sum(o.move_ids_without_package.mapped('quantity'))"/>
            <tr>
                <td><strong/></td>
                <td><strong/></td>
                <td><strong/></td>
                <td><strong/></td>
                <td><strong>TOTAL PRODUCTO</strong></td>
                <td class="text-end"><strong><t t-out="format_number(cantidad_producto)"/></strong></td>
            </tr>
        </xpath>
    </template>

    <template id="report_delivery_has_serial_farmanimals" inherit_id="stock.stock_report_delivery_has_serial_move_line">
        <xpath expr="//td[1]" position="before">
            <td><span t-field="move_line.product_id.default_code"/></td>
            <td><span t-field="move_line.product_id.barcode"/></td>
        </xpath>
        <xpath expr="//t[@name='move_line_lot']" position="after">
            <td class="text-end"><span t-field="move_line.lot_id.expiration_date"/></td>
        </xpath>
    </template>
</odoo>
